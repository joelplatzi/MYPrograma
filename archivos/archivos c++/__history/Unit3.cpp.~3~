Cardinal CantDig(AnsiString nom){
  Cardinal c=0; char x;
  fstream pf(nom.c_str());
  if(!pf.fail()){ //sino fallo al abrir
	 while(!pf.eof()){
		x=pf.get();
		if(!pf.eof()){
		   if(isdigit(x)){
			  c++;
		   }
		}
	 }
	 pf.close();
  }
  return c;
}
