Cardinal CantNumeros(AnsiString num){
 byte c=0; char x; bool b;
 fstream pf(num.c_str());
 if(!pf.fail()){
	 b=false;
	 while(!pf.eof()){
		 x=pf.get();
		 if(!pf.eof()){
			if(isdigit(x)){
			   if(!b){
				  c++;
				  b=true;
			   }
			}else{
				b=false;
            }
		 }
	 }
     pf.close();
 }
 return c;
}
