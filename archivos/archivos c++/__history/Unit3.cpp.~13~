Cardinal CantVoc(AnsiString nom){
  char x; Cardinal c=0;
  fstream pf(nom.c_str());
  if(!pf.fail()){  //si no fallo al abrir
	  while(!pf.eof()){ //mientras no hayga leido la marca de fin de archivo
		  x=pf.get();
		  if(!pf.eof()){
			  if(EsVocal(x)){
				 c++;
			  }
		  }
	  }
	  pf.close();
  }
  return c;
}
