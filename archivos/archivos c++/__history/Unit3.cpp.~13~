void MayusMinus(char lin[]){
  Word i,n,p;   bool sw=false;
  AnsiString may="QWERTYUIOPASDFGHJKL—ZXCVBNM¡…Õ”⁄";
  AnsiString min="qwertyuiopasdfghjklÒzxcvbnm·ÈÌÛ˙";
  n=strlen(lin); //para saber la longitud
  for(i=0; i<n; i++){
	 if(EsPalabra(lin[i])){
		if(sw){ //otras letras
		   p=may.Pos(lin[i]);
		   if(p>0){
			   lin[i]=min[p];
		   }
		}else{ //primer letra
			p=min.Pos(lin[i]);
			if(p>0){
			   lin[i]=may[p];
			}
			sw=true;
		}
	 }
  }
}
