 //devuelve el codigo del nombre a buscar
Word buscarNombre(AnsiString nombrefile,AnsiString buscarNombre){
	fstream fa(nombrefile.c_str(),ios::in);
	RegIdxNomCancion reg;
	Word codi=0;
	if(!fa.fail()){
	//AnsiString buscarNombre=InputBox("ingrese","nombre","");
		fa.read((char*)&reg,sizeof(reg));
		while(!fa.eof() && !(compare(buscarNombre,reg.clave))){
		   fa.read((char*)&reg,sizeof(reg));
		}
		if(!fa.eof())
		  codi=reg.direccion;
		fa.close();
	}
	return codi;
}
