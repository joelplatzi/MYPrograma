							 k=j;
                             regk=regj;
							 //strcpy(regk.nom,regj.nom);
						}
					}
				}
		  }
		  //intercambiamos los registros
		  fi.close();
		  fi.open(archIdx.c_str(),ios::in|ios::out|ios::binary);
		  if(i!=k){
			 fi.seekg(k,ios::beg);
			 fi.write((char*)&regi,sizeof(regi));
