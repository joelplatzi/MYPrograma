  //buscando nombre  de canciones.dat
void encontrarNombre(AnsiString nombrefile,AnsiString nombre){
  RegIdxNomCancion regidx;
  RegCancion reg;
  fstream fd(nombrefile.c_str(),ios::in|ios::binary);
  fstream fi("idx2C.idx",ios::out|ios::binary);
  if(!fd.fail()){
	 while(!fd.eof()){
		  regidx.direccion=fd.tellg();
		  fd.read((char*)&reg,sizeof(reg));
		  if(!fd.eof() && (compare(nombre,reg.artista))){
			  strcpy(regidx.clave,reg.artista);
			  fi.write((char*)&regidx,sizeof(regidx));
		  }
	 }
  }
  fd.close(); fi.close();
  ShowMessage("Indice creado");
}

