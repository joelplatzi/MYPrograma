   AnsiString may="QWERTYUIOPASDFGHJKLÑZXCVBNM";
   cad="";
   n=strlen(r.dir);
   for(i=0; i<n; i++){
	   p=min.Pos(r.dir[i]);
	   if(p>0){
		   cad=cad+may[p];
		   r.dir[i]=may[p];
