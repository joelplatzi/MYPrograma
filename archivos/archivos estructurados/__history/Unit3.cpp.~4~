void __fastcall TForm3::Button3Click(TObject *Sender)
{
   AnsiString nomArch=ruta+nom;
   AnsiString lis=ruta+"listado.txt";
   RegAlumno reg; AnsiString linea; Word i,n;
   fstream f1(nomArch.c_str(),ios::binary|ios::in);
   fstream f2(lis.c_str(),ios::out);
   if(!f1.fail()){
	 linea="LISTADO DE ALUMNOS";
	 n=linea.Length();
	 for(i=1; i<=n; i++){
		 f2.put(linea[i]);
	 }
	 f2.put(10);
	 while(!f1.eof()){
		 f1.read((char*)&reg,sizeof(reg));
		 if(!f1.eof()){
			 linea=reg.cod;
			 linea=linea+","+reg.nom+","+reg.dir+","+reg.fecha.dia+"/"+reg.fecha.mes+"/"+reg.fecha.año;
			 n=linea.Length();
			 for(i=1; i<=n; i++){
				 f2.put(linea[i]);
			 }
			 f2.put(10);
		 }
	 }
	 f1.close(); f2.close();
	 ShowMessage("Listado generado");
   }
}
