void ConvAMayus(RegAlumno &r){
  byte i,n,p; //convertimos a mayusculas solo el nombre
  AnsiString min="qwertyuiopasdfghjklñzxcvbnm";
  AnsiString may="QWERTYUIOPASDFGHJKLÑZXCVBNM";
  n=strlen(r.nom);
  for(i=0; i<n; i++){
	  p=min.Pos(r.nom[i]);
      if(p>0){
		  r.nom[i]=may[p];
	  }
  }

}
void __fastcall TForm3::Button4Click(TObject *Sender)
{
  RegAlumno reg; AnsiString nomArch=ruta+nom; Word i,n,p;
  fstream f(nomArch.c_str(),ios::binary|ios::in|ios::out);
  if(!f.fail()){
	  while(!f.eof()){
		   f.read((char*)&reg,sizeof(reg)); //al hacer read el puntero se baja de forma secuencial
		   if(!f.eof()){
			   ConvAMayus(reg); //convertir a mayuscula
			   p=f.tellg(); //nos dice donde esta el archivo antes de que se mueva
			   f.seekg(-sizeof(reg),ios::cur); //cur:donde esta ahurita el puntero de archivo
			   //una vez movido el puntero deja de ser secuencial el objeto
			   f.write((char*)&reg,sizeof(reg));
			   f.seekg(p);
		   }
	  }
	  f.close();
	  ShowMessage("Archivo actualizado");
  }
}
