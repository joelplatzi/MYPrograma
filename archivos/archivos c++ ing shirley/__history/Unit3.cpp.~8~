 bool EsLetra(char x){
   AnsiString letra="qwertyuiopasdfghjklñzxcvbnmQWERTYUIOPASDFGHJKLÑZXCVBNM";
   return letra.Pos(x)>0;
 }
 void MayMin(char &x){
   Word i,p,n;
   AnsiString min="qwertyuiopasdfghjklzxcvbnm";
   AnsiString may="QWERTYUIOPASDFGHJKLÑZXCVBNM";
   if(EsLetra(x)){
	   p=may.Pos(x);
	   if(p>0)
		 x=min[p];
   }
 }
void SearchAndReplace(AnsiString name,AnsiString &search,AnsiString replace){
 char x; Word n=search.Length(); byte i;
 AnsiString cad;
 fstream f(name.c_str());
 ofstream fo("temporal.tmp");
 if(!f.fail()){
	 while(!f.eof()){
		   x=f.get();
			MayMin(x);
			MayMin(search[1]);
		   if(x==search[1]){
			   i=1;
			   cad="";
				while(i<=n && !f.eof() && x==search[i]){
					cad=cad+x;
					x=f.get();
                    MayMin(x);
					i++;
					if(i<n)
					 MayMin(search[i]);
				}
				if(i>n){ //lo encontro
					for(i=1; i<=replace.Length(); i++){
						  fo.put(replace[i]);
					}
                    if(!f.eof())
					fo.put(x);
				}else{ //no lo encontro
					 for(i=1; i<=cad.Length(); i++){
						  fo.put(cad[i]);
					 }
					 if (!f.eof())
					 fo.put(x);
                }
		   }else{
			   if(!f.eof())
			   fo.put(x);
           }
	 }
	 f.close();
	 fo.close();
	 remove(name.c_str());
	 rename(nombreArchivo.c_str(),name.c_str());
 }

}
