 Cardinal SearchAndReplace(AnsiString nom,AnsiString search){
  Cardinal c=0; char x; byte i,n=search.Length();
  AnsiString cad;
   fstream f(nom.c_str());  //lectura
   if(!f.fail()){
	   while(!f.eof()){
			x=f.get();
			if(x==search[1]){
			   i=1;
			   while(i<=n && !f.eof() && x==search[i]){
					x=f.get();
					i++;
			   }
			   if(i>n){ //lo encontro
				  c++;
			   }
			}
	   }
	   f.close();
   }
  return c;
 }
