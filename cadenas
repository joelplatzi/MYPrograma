create database mecanico;
use mecanico;
-- Creación de la tabla TIPO
CREATE TABLE TIPO (
    ID INT PRIMARY KEY,
    NOMBRE VARCHAR(50) NOT NULL
);

-- Creación de la tabla PERSONA
CREATE TABLE PERSONA (
    CI INT PRIMARY KEY,
    NOMBRE VARCHAR(100) NOT NULL,
    TELEFONO VARCHAR(20),
    DIRECCION VARCHAR(150),
    CORREO VARCHAR(100)
);

-- Creación de la tabla de relación PERTENECE_TIPO (Persona pertenece a Tipo)
CREATE TABLE PERTENECE_TIPO (
    CI INT,
    IDTIPO INT,
    PRIMARY KEY (CI, IDTIPO),
    FOREIGN KEY (CI) REFERENCES PERSONA(CI) ON DELETE CASCADE,
    FOREIGN KEY (IDTIPO) REFERENCES TIPO(ID) ON DELETE CASCADE
);

-- Creación de la tabla VEHICULO
CREATE TABLE VEHICULO (
    PLACA VARCHAR(20) PRIMARY KEY,
    MARCA VARCHAR(50) NOT NULL,
    MODELO VARCHAR(50) NOT NULL,
    AÑO INT
);

-- Creación de la tabla NOTARECEPCION
CREATE TABLE NOTARECEPCION (
    NRO INT PRIMARY KEY,
    FECHA DATE NOT NULL,
    HORA TIME NOT NULL,
    MOTIVO VARCHAR(250),
    CICLIENTE INT,
    CIRECEP INT,
    PLACAVEHICULO VARCHAR(20),
    FOREIGN KEY (CICLIENTE) REFERENCES PERSONA(CI),
    FOREIGN KEY (CIRECEP) REFERENCES PERSONA(CI),
    FOREIGN KEY (PLACAVEHICULO) REFERENCES VEHICULO(PLACA)
);

-- Creación de la tabla ACCESORIO
CREATE TABLE ACCESORIO (
    ID INT PRIMARY KEY,
    NOMBRE VARCHAR(100) NOT NULL
);

-- Creación de la tabla de relación PERTENECE (Accesorios que vienen en la Nota de Recepción)
CREATE TABLE PERTENECE (
    NRO INT,
    IDACCE INT,
    ESTADO VARCHAR(250),
    PRIMARY KEY (NRO, IDACCE),
    FOREIGN KEY (NRO) REFERENCES NOTARECEPCION(NRO) ON DELETE CASCADE,
    FOREIGN KEY (IDACCE) REFERENCES ACCESORIO(ID) ON DELETE CASCADE
);

