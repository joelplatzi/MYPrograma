create database examen2;
use examen2;

create table cliente(
  ci int primary key,
  nombre varchar(30) not null,
  telefono int not null
);

create table factura(
  nro int primary key,
  fecha date not null,
  monto int not null,
  cicliente int not null,
  foreign key(cicliente) references cliente(ci)
  on update cascade on delete cascade
);

create table categoria(
  id int primary key,
  descripcion varchar(50) not null,
  idpadre int null,
  foreign key (idpadre) references categoria(id)
  on update cascade on delete cascade
);

create table producto(
  codigo varchar(5) primary key,
  nombre varchar(50) not null,
  preciov int not null,
  idcategoria int not null,
  foreign key (idcategoria) references categoria(id)
  on update cascade on delete cascade
);

create table detallefactura(
  nrof int not null,
  id int not null,
  primary key(nrof,id),
  foreign key (nrof) references factura(nro)
  on update cascade on delete cascade,
  cantidad int not null,
  precio int not null,
  codigop varchar(5) not null,
  foreign key (codigop) references producto(codigo)
  on update cascade on delete cascade
);

