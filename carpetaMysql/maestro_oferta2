create database MAESTRO_OFERTA2;
use MAESTRO_OFERTA2;

create table docente(
 codigo int primary key,
 nombre varchar(50) 
);

create table materia(
  sigla char(6) primary key,
  nombre varchar(50)
);
-- drop table grupo;
-- drop table horario;

select * from semestre;
create table semestre(
   id tinyint primary key,
   semestre tinyint not null,
   anio year not null
);

create table Estudiante(
  registro int primary key,
  nombre varchar(50) not null,
  telefono int not null
);
-- DROP TABLE boletaIns;
create table boletaIns(
    nro int primary key,
    fecha date not null,
    hora time not null,
    regEst int not null,
    idSemestre tinyint not null,
    foreign key(regEst) references Estudiante(registro)
    on delete cascade on update cascade,
    foreign key(idSemestre) references semestre(id)
    on delete cascade on update cascade
);

create table inscribe(
  nroBoleta int not null,
  idGrupo tinyint not null,
  foreign key(nroBoleta) references boletaIns(nro)
  on delete cascade on update cascade,
  foreign key(idGrupo) references grupo(id)
  on delete cascade on update cascade
);

select * from semestre;

create table grupo(
  id tinyint primary key,
  nombre char(2) not null,  -- ERROR no pude ser primary key
  cupo smallint not null,
  siglaMateria char(6) not null,
  codigoDocente int not null,
  foreign key(codigoDocente) references docente(codigo)
  on delete cascade on update cascade,
  foreign key(siglaMateria) references materia(sigla)
  on delete cascade on update cascade
);
select * from grupo;
