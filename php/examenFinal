package prueba;

public class ArbolFrec {
  
	public NodoFrec raiz;
	
	private int mayorFrec;
	private String palabraFrec;
	
	public void insertar(String x) {
		raiz=insertar(raiz,x);
	}
	private NodoFrec insertar(NodoFrec p,String x) {
		if(p==null)
			return new NodoFrec(x);
		if(x.equalsIgnoreCase(p.elem))
			p.frec++;
		else if(x.compareToIgnoreCase(p.elem)>0)
			p.izq=insertar(p.izq,x);
		else
			p.der=insertar(p.der,x);
		return p;
	}
	
	public void mostrarMenMay() {
		mostrarMenMay(raiz);
	}
	private void mostrarMenMay(NodoFrec p) {
		if(p==null)
			return;
		mostrarMenMay(p.izq);
		System.out.println("palabra "+p.elem+" frecuencia :"+p.frec);
		mostrarMenMay(p.der);
	}
	
	//1palabra con mayor frecuencia ->mas frecunte
	
	public void palabraMasFrecuente() {
		palabraFrec="";
		mayorFrec=0;
		palabraMasFrecuente(raiz);
		System.out.println("palabra mas frecuencia :"+palabraFrec+" frecuencia :"+mayorFrec);
	}
	private void palabraMasFrecuente(NodoFrec p) {
		if(p==null)
			return ;
		palabraMasFrecuente(p.izq);
		if(p.frec>mayorFrec) {
			mayorFrec=p.frec;
			palabraFrec=p.elem;
		}
		palabraMasFrecuente(p.der);
			
	}
	//Mostrar todas las palabras cuya frecuencia sea mayor que un número n
	public void palabraFrecN(int n) {
		palabraFrecN(raiz,n);
	}
	private void palabraFrecN(NodoFrec p,int n) {
		if(p==null)
			return;
		palabraFrecN(p.izq,n);
		if(p.frec>n)
			System.out.println(p.elem);
		palabraFrecN(p.der,n);
		
	}
	
	//Contar cuántas palabras diferentes existen.
    public int palabrasDiferentes() {
    	return palabrasDiferentes(raiz);
    }
    private int palabrasDiferentes(NodoFrec p) {
    	if(p==null)
    		return 0;
    	return palabrasDiferentes(p.izq)+palabrasDiferentes(p.der)+1;
    }
  
    //Mostrar las palabras que aparecen una sola vez.
    
    public void palabraUnaVez() {
    	palabraUnaVez(raiz);
    }
    private void palabraUnaVez(NodoFrec p) {
    	if(p==null)
    		return;
    	palabraUnaVez(p.izq);
    	if(p.frec==1)
    		System.out.println("palabra "+p.elem+" una vez con "+p.frec);
    	palabraUnaVez(p.der);
    }
  
    //Mostrar la frecuencia total de todas las palabras.
    public int frecuenciaTotal() {
    	return frecuenciaTotal(raiz);
    }
    private int frecuenciaTotal(NodoFrec p) {
    	if(p==null)
    		return 0;
    	return frecuenciaTotal(p.izq)+frecuenciaTotal(p.der)+p.frec;
    }
  
  
  
    
  
  
  
  
  
	

