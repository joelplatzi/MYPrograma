package create;

public class Arbol11 {
	 public Nodo11 raiz;

	    public Arbol11() {
	        this.raiz = null;
	    }

	    public void insertar(int x) {
	        raiz = insertar(raiz, x);
	    }

	    private Nodo11 insertar(Nodo11 p, int x) {
	        if (p == null) return new Nodo11(x);
	        
	        if (x < p.elem) {
	            p.izq = insertar(p.izq, x);
	        } else if (x > p.elem) { 
	            p.der = insertar(p.der, x);
	        }
	        return p;
	    }

	    public void inOrden() {
	        inOrden(raiz);
	    }

	    private void inOrden(Nodo11 p) {
	        if (p == null) return;
	        inOrden(p.izq);
	        System.out.print(p.elem + " ");
	        inOrden(p.der);
	    }
	    
	    public void inOrdenDesc() {
	        inOrdenDesc(raiz);
	    }

	    private void inOrdenDesc(Nodo11 p) {
	        if (p == null)
	            return;

	        inOrdenDesc(p.der);
	        System.out.print(p.elem + " ");
	        inOrdenDesc(p.izq);
	    }
	    //
	    public void inOrdenDesc2() {
	        inOrdenDesc2(raiz);
	    }
 // usamos el mismo nodo para el ejrcicio 2 ya que tiene similar extructura
	    private void inOrdenDesc2(Nodo11 p) {

	        if(p==null)
	            return;

	        inOrdenDesc2(p.der);

	        System.out.print(p.elem + " ");

	        inOrdenDesc2(p.izq);
	    }
	    
	    //ejercicios al menos 5
	    //1.Contar cuántos elementos hay en cada ABB.
	    public int cantidadNodos() {
	    	return cantidadNodos(raiz);
	    }
	    private int cantidadNodos(Nodo11 p) {
	    	if(p==null)
	    		return 0;
	       return 1+cantidadNodos(p.izq)+cantidadNodos(p.der);
	        
	    }
	    
	    //4.mostrar solamente los numeros pares
	    public void numerosPares() {
	    	 numerosPares(raiz);
	    }
	    private void numerosPares(Nodo11 p) {
	    	if(p==null)
	    		return ;
	    	numerosPares(p.izq);
	    	if(p.elem%2==0)
	    		System.out.print(p.elem + " ");
	    	numerosPares(p.der);
	    }
	    
	    
	  //5.buscar en que ABB esta un numero
	    public boolean existeABB(int x) {
	    	return existeABB(raiz,x);
	    }
	    
	    private boolean existeABB(Nodo11 p,int x) {
	    	if(p==null)
	    		return false;
	    	if(p.elem==x)
	    		return true;
	    	if(x<p.elem)
	    		return existeABB(p.izq,x);
	    	return existeABB(p.der,x);
	    	
	    	
	    }

}
