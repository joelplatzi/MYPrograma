    	}
    }
    
    //2.Mostrar el ABB que tiene mas elementos
    public void mostrarMayorEle() {
    	int pos=0;
    	int mayor=0;
    	for(int i=0;i<L1.size();i++) {
    		int cant=L1.get(i).cantidadNodos();
    		if(cant>mayor) {
    			mayor=cant;
    			pos=i;
    		}
    			
    	}
    	System.out.println("El arbol terminado en "+ pos+" tiene "+mayor+ " elemento");
    }
    //3.contar el total de elementos de toda la lista
    public int mostrarTotalElem() {
